<Window x:Class="Labor_4_Shakirova.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Инженерный калькулятор - Shakirova" 
        Height="700" Width="550"
        Style="{DynamicResource WindowStyle}"
        MinHeight="650" MinWidth="500"
        KeyDown="Window_KeyDown">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и выбор темы -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="Инженерный Калькулятор" Style="{DynamicResource TitleStyle}"/>
            <ComboBox x:Name="themeSelector" 
                      Style="{DynamicResource ComboBoxStyle}"
                      Width="150" Margin="20,10,10,10"
                      SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Светлая тема"/>
                <ComboBoxItem Content="Темная тема"/>
            </ComboBox>
        </StackPanel>

        <!-- Верхний дисплей: Выражение -->
        <TextBox x:Name="expressionDisplay" 
                 Grid.Row="1" 
                 Style="{DynamicResource ExpressionDisplayStyle}"
                 Text=""/>

        <!-- Нижний дисплей: Результат/Текущий ввод -->
        <TextBox x:Name="display" 
                 Grid.Row="2" 
                 Style="{DynamicResource DisplayStyle}"
                 Text="0"/>

        <!-- Сетка кнопок -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ряд 1: Тригонометрия и корни -->
            <Button Content="sin" Grid.Row="0" Grid.Column="0" Style="{DynamicResource FunctionButtonStyle}" Click="Sin_Click"/>
            <Button Content="cos" Grid.Row="0" Grid.Column="1" Style="{DynamicResource FunctionButtonStyle}" Click="Cos_Click"/>
            <Button Content="tan" Grid.Row="0" Grid.Column="2" Style="{DynamicResource FunctionButtonStyle}" Click="Tan_Click"/>
            <Button Content="√" Grid.Row="0" Grid.Column="3" Style="{DynamicResource FunctionButtonStyle}" Click="Sqrt_Click"/>
            <Button Content="x²" Grid.Row="0" Grid.Column="4" Style="{DynamicResource FunctionButtonStyle}" Click="Square_Click"/>

            <!-- Ряд 2: Логарифмы и константы -->
            <Button Content="log" Grid.Row="1" Grid.Column="0" Style="{DynamicResource FunctionButtonStyle}" Click="Log_Click"/>
            <Button Content="ln" Grid.Row="1" Grid.Column="1" Style="{DynamicResource FunctionButtonStyle}" Click="Ln_Click"/>
            <Button Content="π" Grid.Row="1" Grid.Column="2" Style="{DynamicResource FunctionButtonStyle}" Click="Pi_Click"/>
            <Button Content="e" Grid.Row="1" Grid.Column="3" Style="{DynamicResource FunctionButtonStyle}" Click="E_Click"/>
            <Button Content="x!" Grid.Row="1" Grid.Column="4" Style="{DynamicResource FunctionButtonStyle}" Click="Factorial_Click"/>

            <!-- Ряд 3: Очистка и скобки -->
            <Button Content="C" Grid.Row="2" Grid.Column="0" Style="{DynamicResource ClearButtonStyle}" Click="Clear_Click"/>
            <Button Content="CE" Grid.Row="2" Grid.Column="1" Style="{DynamicResource ClearButtonStyle}" Click="ClearEntry_Click"/>
            <Button Content="(" Grid.Row="2" Grid.Column="2" Style="{DynamicResource OperatorButtonStyle}" Click="OpenParenthesis_Click"/>
            <Button Content=")" Grid.Row="2" Grid.Column="3" Style="{DynamicResource OperatorButtonStyle}" Click="CloseParenthesis_Click"/>
            <Button Content="÷" Grid.Row="2" Grid.Column="4" Style="{DynamicResource OperatorButtonStyle}" Click="Divide_Click"/>

            <!-- Ряд 4: 7-9, умножение, степень -->
            <Button Content="7" Grid.Row="3" Grid.Column="0" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="8" Grid.Row="3" Grid.Column="1" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="9" Grid.Row="3" Grid.Column="2" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="×" Grid.Row="3" Grid.Column="3" Style="{DynamicResource OperatorButtonStyle}" Click="Multiply_Click"/>
            <Button Content="xʸ" Grid.Row="3" Grid.Column="4" Style="{DynamicResource FunctionButtonStyle}" Click="Power_Click"/>

            <!-- Ряд 5: 4-6, минус, 1/x -->
            <Button Content="4" Grid.Row="4" Grid.Column="0" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="5" Grid.Row="4" Grid.Column="1" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="6" Grid.Row="4" Grid.Column="2" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="-" Grid.Row="4" Grid.Column="3" Style="{DynamicResource OperatorButtonStyle}" Click="Subtract_Click"/>
            <Button Content="1/x" Grid.Row="4" Grid.Column="4" Style="{DynamicResource FunctionButtonStyle}" Click="Reciprocal_Click"/>

            <!-- Ряд 6: 1-3, плюс, ± -->
            <Button Content="1" Grid.Row="5" Grid.Column="0" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="2" Grid.Row="5" Grid.Column="1" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="3" Grid.Row="5" Grid.Column="2" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="+" Grid.Row="5" Grid.Column="3" Style="{DynamicResource OperatorButtonStyle}" Click="Add_Click"/>
            <Button Content="±" Grid.Row="5" Grid.Column="4" Style="{DynamicResource FunctionButtonStyle}" Click="Negate_Click"/>

            <!-- Ряд 7: 0, точка, равно -->
            <Button Content="0" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" Style="{DynamicResource ButtonStyle}" Click="Number_Click"/>
            <Button Content="." Grid.Row="6" Grid.Column="2" Style="{DynamicResource ButtonStyle}" Click="Decimal_Click"/>
            <Button Content="=" Grid.Row="6" Grid.Column="3" Grid.ColumnSpan="2" Style="{DynamicResource EqualsButtonStyle}" Click="Equals_Click"/>

            <!-- Ряд 8: Обратные триг. функции и экспоненты -->
            <Button Content="asin" Grid.Row="7" Grid.Column="0" Style="{DynamicResource FunctionButtonStyle}" Click="Asin_Click"/>
            <Button Content="acos" Grid.Row="7" Grid.Column="1" Style="{DynamicResource FunctionButtonStyle}" Click="Acos_Click"/>
            <Button Content="atan" Grid.Row="7" Grid.Column="2" Style="{DynamicResource FunctionButtonStyle}" Click="Atan_Click"/>
            <Button Content="10ˣ" Grid.Row="7" Grid.Column="3" Style="{DynamicResource FunctionButtonStyle}" Click="PowerOf10_Click"/>
            <Button Content="eˣ" Grid.Row="7" Grid.Column="4" Style="{DynamicResource FunctionButtonStyle}" Click="Exp_Click"/>
        </Grid>
    </Grid>
</Window>