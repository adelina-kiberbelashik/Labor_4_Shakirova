<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Стиль окна -->
    <Style x:Key="WindowStyle" TargetType="Window">
        <Setter Property="Background" Value="#F5F0FF"/>
        <Setter Property="Foreground" Value="#4A148C"/>
    </Style>

    <!-- Дисплей выражения (верхний) -->
    <Style x:Key="ExpressionDisplayStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#F3E5F5"/>
        <Setter Property="Foreground" Value="#7B1FA2"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="BorderBrush" Value="#CE93D8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Margin" Value="10,5,10,5"/>
        <Setter Property="MinHeight" Value="40"/>
    </Style>

    <!-- Дисплей результата (нижний) -->
    <Style x:Key="DisplayStyle" TargetType="TextBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#6A1B9A"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="BorderBrush" Value="#CE93D8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="TextAlignment" Value="Right"/>
        <Setter Property="Margin" Value="10,5,10,15"/>
    </Style>

    <!-- Базовый стиль кнопки -->
    <Style x:Key="ButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="#E1BEE7"/>
        <Setter Property="Foreground" Value="#4A148C"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#BA68C8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="3"/>
        <Setter Property="Cursor" Value="Hand"/>

        <!-- ТРИГГЕР 1: Свойство IsMouseOver -->
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#CE93D8"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
            </Trigger>

            <!-- ТРИГГЕР 2: Мультитриггер (Наведение + Нажатие) -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"/>
                    <Condition Property="IsPressed" Value="True"/>
                </MultiTrigger.Conditions>
                <MultiTrigger.Setters>
                    <Setter Property="Background" Value="#AB47BC"/>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.95" ScaleY="0.95"/>
                        </Setter.Value>
                    </Setter>
                </MultiTrigger.Setters>
            </MultiTrigger>

            <!-- ТРИГГЕР 3: Событийный триггер (Анимация при клике) -->
            <EventTrigger RoutedEvent="Click">
                <EventTrigger.Actions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" 
                                             To="0.7" Duration="0:0:0.1" AutoReverse="True"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger.Actions>
            </EventTrigger>
        </Style.Triggers>
    </Style>

    <!-- Операторы (+ - * /) -->
    <Style x:Key="OperatorButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background" Value="#D1C4E9"/>
        <Setter Property="Foreground" Value="#512DA8"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Функции (sin, cos...) -->
    <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background" Value="#B39DDB"/>
        <Setter Property="Foreground" Value="#311B92"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- Равно -->
    <Style x:Key="EqualsButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background" Value="#9575CD"/>
        <Setter Property="Foreground" Value="#FFFFFF"/>
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Очистка -->
    <Style x:Key="ClearButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonStyle}">
        <Setter Property="Background" Value="#EF9A9A"/>
        <Setter Property="Foreground" Value="#B71C1C"/>
    </Style>

    <!-- ComboBox темы -->
    <Style x:Key="ComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="#6A1B9A"/>
        <Setter Property="BorderBrush" Value="#CE93D8"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Padding" Value="5"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Заголовок -->
    <Style x:Key="TitleStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#6A1B9A"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,10,0,5"/>
    </Style>
</ResourceDictionary>